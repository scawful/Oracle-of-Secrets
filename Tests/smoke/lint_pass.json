{
  "name": "Static Analysis Lint Pass",
  "description": "Tier 1 lint: ensure metadata and hard-safety checks are in sync (no emulator required). Steps that read build outputs ({rom}, {sym}, {hooks}) skip when those files are absent; pass --rom to lint a specific build.",
  "version": "1.1",
  "tags": ["smoke", "lint", "static-analysis", "tier1"],
  "timeout_seconds": 60,
  "requiresEmulator": false,
  "steps": [
    {
      "type": "exec",
      "command": [
        "python3",
        "Scripts/Build/verify_feature_flags.py",
        "--root",
        "{repo}"
      ],
      "expectedExitCode": 0,
      "description": "Feature flags should be consistent"
    },
    {
      "type": "exec",
      "command": [
        "python3",
        "Scripts/Validate/verify_hooks_json.py",
        "--root",
        "{repo}",
        "--rom",
        "{rom}",
        "--hooks",
        "{hooks}"
      ],
      "skipIfMissing": ["{rom}", "{hooks}"],
      "expectedExitCode": 0,
      "description": "hooks.json should match generator output"
    },
    {
      "type": "exec",
      "command": [
        "python3",
        "Scripts/Validate/validate_sprite_registry.py",
        "--strict"
      ],
      "expectedExitCode": 0,
      "description": "Sprite registry IDs should be up-to-date and valid"
    },
    {
      "type": "exec",
      "command": [
        "python3",
        "{analyzer}",
        "{rom}",
        "--sym",
        "{sym}",
        "--hooks",
        "{hooks}",
        "--check-sprite-tables"
      ],
      "skipIfMissing": ["{analyzer}", "{rom}", "{sym}", "{hooks}"],
      "expectedExitCode": 0,
      "description": "Sprite property tables should not overflow past ID $F2"
    },
    {
      "type": "exec",
      "command": [
        "python3",
        "Scripts/Build/check_zscream_overlap.py",
        "--symbols",
        "{sym}"
      ],
      "skipIfMissing": ["{sym}"],
      "expectedExitCode": 0,
      "description": "No ZScream overlaps should be detected"
    }
  ],
  "onFailure": {
    "expert": "nayru",
    "context": "Tier 1 lint failed. Fix the failing step (flags, hooks.json, sprite registry, or overlap check) before proceeding."
  }
}
